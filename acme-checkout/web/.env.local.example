# Copy this file to .env.local (same directory) and fill in the values.
# Used by the Next.js dev server.

# ─── Stripe (test mode) ────────────────────────────────────────────────
# Frontend reads this via Stripe.js. Test-mode only — get yours at:
#   https://dashboard.stripe.com/test/apikeys
# Or use the one Raj shared in chat.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the FastAPI server lives. Leave as localhost:8000 for local dev.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ─── Clerk (test mode) ─────────────────────────────────────────────────
# Get keys at: https://dashboard.clerk.com → "API Keys"
# Or use the ones Raj shared in chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
