{
  "name": "stripe-checkout-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Sample Stripe one-time checkout: FastAPI server + Next.js (App Router) web client. Used as a target for the FetchSandbox MCP integration coach.",
  "scripts": {
    "dev:web": "pnpm --filter ./web dev",
    "dev:server": "cd server && uvicorn main:app --env-file .env --reload --port 8000",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\""
  },
  "dependencies": {
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@stripe/stripe-js": "^4.10.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@clerk/nextjs": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3",
    "concurrently": "^9.1.0"
  },
  "packageManager": "pnpm@9.12.3"
}
