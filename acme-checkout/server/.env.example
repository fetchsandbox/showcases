# Copy this file to .env (same directory) and fill in the values below.
#
# All keys here are TEST-mode for Stripe + Clerk (safe to use, never charge
# real cards). The Resend key is REAL but only sends to the email tied to
# YOUR Resend account — see the README for setup.

# ─── Stripe (test mode) ────────────────────────────────────────────────
# Test-mode Stripe keys never touch real money. Get yours at:
#   https://dashboard.stripe.com/test/apikeys
# Or use the ones Raj shared in chat to skip setup.
STRIPE_SECRET_KEY=sk_test_...

# Generated by `stripe listen --forward-to localhost:8000/webhook` —
# the CLI prints a whsec_... value the first time you run it.
# Paste that here. If you skip stripe-listen, the receipt step never
# fires (webhooks won't reach this server).
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Clerk (test mode) ─────────────────────────────────────────────────
# Test mode lets you sign in with fake emails (any@example.com works).
# Get keys at: https://dashboard.clerk.com → choose any project →
# "API Keys" section. Or use the ones Raj shared in chat.
CLERK_JWT_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_clerk_...

# ─── Resend (REAL — sends actual emails) ──────────────────────────────
# Get a free Resend API key at: https://resend.com/api-keys
# - Sign up (uses your real email)
# - Click "Create API Key" → "Sending access" → any name
# - Copy the re_... value here
#
# Note: with the default sender (onboarding@resend.dev), Resend ONLY
# delivers emails to the email tied to YOUR Resend account. You won't
# be able to send to other people's emails unless you verify a domain.
# This is fine for the demo — sign in to Clerk with the SAME email you
# used to sign up to Resend, and the receipt lands in your inbox.
RESEND_API_KEY=re_...
RESEND_FROM=onboarding@resend.dev

# ─── Downstream service stubs (no setup needed for the demo) ──────────
# In a real app these would be your orders-service. For this demo they
# can be any string; the code calls them but failure is non-blocking
# for the email-receipt happy path you'll be testing.
ORDERS_SERVICE_URL=http://localhost:9999
ORDERS_SERVICE_TOKEN=demo-token-can-be-anything
