# Copy this file to .env.local (same directory) and fill in the values.

# ─── Twilio ────────────────────────────────────────────────────────────
# Twilio test credentials. Get them at:
#   https://console.twilio.com/us1/develop/sms/try-it-out/test-credentials
# Test credentials NEVER send real SMS and never bill — perfect for the demo.
# The "magic numbers" in the test environment:
#   +15005550006  → always succeeds
#   +15005550001  → always invalid number error
#   +15005550009  → returns 'undeliverable'
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Sender number — for test credentials, use the magic success number:
TWILIO_FROM_NUMBER=+15005550006

# Where status callbacks should be POSTed. For local dev, expose your
# localhost via ngrok / cloudflared / similar and put the public URL here.
# If empty, the integration still sends the SMS but won't reconcile
# delivered/undelivered status updates.
TWILIO_STATUS_CALLBACK_URL=
